# ============================
# LaTeX build intermediates
# (keep .tex/.bib/figures; ignore aux/log/blg outputs)
# ============================
paper/**/*.aux
paper/**/*.bbl
!paper/*Camera Ready*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.synctex.gz
paper/**/*.out

